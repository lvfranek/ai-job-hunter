# Supabase (required — see README for setup)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Access password (required) — protects the whole app behind a login screen.
# Generate:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt(process.argv[1],s,64,(e,k)=>console.log(s+':'+k.toString('hex')))" "your-password-here"
AUTH_PASSWORD_HASH=

# Encrypts API keys you enter via Settings → API Keys before storing them in the DB.
# Generate:
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# OpenRouter — optional here: leave blank and set via Settings → API Keys after login.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Use a fast INSTRUCT model. Reasoning models burn the whole token budget
# on internal reasoning and return empty content for this task.
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct

# Apify — optional here: leave blank and set via Settings → API Keys after login.
APIFY_API_KEY=your-apify-api-key-here
APIFY_SCRAPER_INDEED=your-indeed-scraper-id
APIFY_SCRAPER_LINKEDIN=your-linkedin-scraper-id
APIFY_SCRAPER_XING=your-xing-scraper-id
APIFY_SCRAPER_STEPSTONE=your-stepstone-scraper-id
APIFY_SCRAPER_ARBEITSAGENTUR=your-arbeitsagentur-scraper-id

# Automation (optional) — lets an external scheduler trigger scrapes via
# POST /api/cron/scrape and get notified about high-scoring jobs. See README.
# Generate CRON_SECRET:
#   openssl rand -hex 32
CRON_SECRET=
NOTIFICATION_WEBHOOK_URL=

# App
NEXT_PUBLIC_APP_ENV=development
